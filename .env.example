# Boxentakt – Umgebungsvariablen (in Vercel eintragen; lokal als .env.local)
# Keine echten Werte einchecken.

# Supabase (Projekt → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Basis-URL für Links in Mails und Stripe
APP_URL=https://boxentakt.de

# Mailversand über Resend (Domain boxentakt.de verifizieren)
RESEND_API_KEY=
MAIL_FROM=termine@boxentakt.de
# Optional: Empfänger für Feedback und Monatsbericht (sonst OPERATOR.email)
FEEDBACK_TO=
REPORT_TO=

# Cron (Vercel schickt CRON_SECRET als Bearer-Token mit)
CRON_SECRET=
# = select value from public.app_secrets where name = 'cron_key';
REMINDER_KEY=

# Stripe: Abo (Plattform) und Anzahlungen/Gutscheine (Connect)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# = select value from public.app_secrets where name = 'stripe_key';
STRIPE_DB_KEY=

# Web-Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@boxentakt.de

# Nur Rückfall ohne Resend (Gmail-SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
